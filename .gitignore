# Local task work. Drafts, plans, bundles, ZIPs, and the submission ledger
# stay on the authoring machine and are never part of the published tree.
LEDGER.json
drafts/*
!drafts/.gitkeep
plans/*
!plans/.gitkeep
tasks/*
!tasks/.gitkeep
zip/*
!zip/.gitkeep

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

.DS_Store
*.swp

terminal-bench-reference/